{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bitrix-whatsapp-connector",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",

  "observability": { "enabled": true },

  // Static SPA (ui/ -> public/), fetched explicitly by app-shell.ts's renderApp() and never
  // served directly. run_worker_first is required: without it, Cloudflare auto-serves index.html
  // for any GET matching a static path (including "/") BEFORE our Hono routing runs, bypassing
  // the server-side session-token substitution entirely and shipping the raw, un-substituted
  // placeholder to the browser (observed as a CF cache hit whose body still contained the
  // literal "__CONNECTOR_BOOTSTRAP__" string).
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bitrix_whatsapp",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],

  // Inbound WhatsApp -> Bitrix (phase 3) and outbound Bitrix -> WhatsApp (phase 4). Both routes
  // only enqueue; the queue() consumer in index.ts does the actual REST call, so a slow or
  // failing upstream never holds up Wasender's webhook delivery or Bitrix's event delivery.
  //
  // New queues declared here are NOT auto-created by `wrangler deploy` when they're only
  // referenced as a dead_letter_queue target - run `wrangler queues create <name>` for each
  // *-dlq queue once before the first deploy that adds one.
  "queues": {
    "producers": [
      { "binding": "INBOUND_QUEUE", "queue": "bwac-inbound" },
      { "binding": "OUTBOUND_QUEUE", "queue": "bwac-outbound" }
    ],
    "consumers": [
      {
        "queue": "bwac-inbound",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        // Genuine failures (Bitrix down, auth broken) only - the "not bound to a Line yet" wait
        // is handled by the consumer re-enqueueing itself, not by this retry budget, so it never
        // competes with real failures for the same DLQ threshold.
        "max_retries": 5,
        "dead_letter_queue": "bwac-inbound-dlq"
      },
      {
        "queue": "bwac-inbound-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      },
      {
        "queue": "bwac-outbound",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        // A 429 retries with delaySeconds set from Wasender's own x-ratelimit-reset (index.ts),
        // unlike inbound's bind-wait, and does count against this budget - the wait here is
        // bounded (Wasender's reset window, not a multi-hour operator action), so a message that
        // is still failing after 5 tries genuinely belongs in the dead-letter queue.
        "max_retries": 5,
        "dead_letter_queue": "bwac-outbound-dlq"
      },
      {
        "queue": "bwac-outbound-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },

  "vars": {
    "PUBLIC_URL": "https://YOUR_WORKERS_SUBDOMAIN.workers.dev",

    // Bitrix24 connector identity. ID must stay lowercase/digits/underscore (dots are rejected).
    "CONNECTOR_ID": "whatsapp_connector",
    "CONNECTOR_NAME": "WhatsApp",

    // Bumping this re-runs imconnector.register AND the CRM_TAB_PLACEMENTS placement.bind calls
    // (connector.ts's ensureConnectorRegistered) on the next portal load. This number is only
    // meaningful relative to a specific BITRIX_CLIENT_ID: member_id identifies the Bitrix portal,
    // not which app is installed on it, so upsertPortal matches the same portal row across an
    // uninstall/reinstall OR a swap to an entirely different registered app. Either one leaves
    // connector_version pointing at a registration that no longer exists under the current app's
    // OAuth context. Bump this every time BITRIX_CLIENT_ID changes, not only when connector
    // metadata (name/icon/handler) changes. Bumping it also heals a portal left behind with a
    // stale version (a reinstall whose stored version still matched, so imconnector.register was
    // skipped and Contact Center stayed empty): the install paths no longer trust that column at
    // all (ensureConnectorRegistered's `force`), so the bump only re-registers portals already in
    // that state, without needing another uninstall/reinstall cycle - any app open does it.
    "CONNECTOR_VERSION": "8",
    "APP_VERSION": "0.1.0",

    // Public half of the Bitrix24 app credentials (the secret half is a Worker secret).
    "BITRIX_CLIENT_ID": "YOUR_BITRIX_CLIENT_ID",

    // Maestro licensing (see the maestro-licensing skill). Public key is safe to commit.
    "LICENSE_SERVER_URL": "https://maestro.acp-24.com",
    // Registered Maestro product slug for this app - see src/license.ts.
    "LICENSE_PRODUCT": "wa-connector",
    "LICENSE_PUBLIC_KEY": "MCowBQYDK2VwAyEAlDC/VXlkxQNMnZySCc8Ei9n58vkxGrEFp4+2Ee10pEs=",
    // Set to "true" to gate provisioning and new conversations behind an active license.
    // Leave it "false" until every portal has a key bound via
    // POST /admin/portals/:domain/license - an unkeyed portal is blocked outright the moment
    // this is true.
    "LICENSE_ENFORCE": "false",

    // White-label branding (src/brand.ts). Only honored on a license whose envelope carries
    // features.white_label=true; otherwise the free-tier "Powered by ACP GROUP" attribution is
    // shown. Empty strings mean "fall back to CONNECTOR_NAME / 'WhatsApp Audio' / no link".
    "BRAND_CONNECTOR_NAME": "",
    "BRAND_BOT_NAME": "",
    "BRAND_SUPPORT_URL": "",

    "WASENDER_BASE_URL": "https://wasenderapi.com"
  },

  // Temp audio storage for the IM_TEXTAREA widget. Uploaded recordings are deleted by the Worker
  // after sending (or by a cron cleanup if the send never completed).
  "r2_buckets": [
    {
      "bucket_name": "bwac-audio-staging",
      "binding": "AUDIO_STAGING"
    }
  ],

  // Hourly license revalidation (license.ts's refreshAllPortals via the scheduled handler).
  // ensureFresh skips anything still inside its 12h staleness window, so an hourly tick is cheap
  // - it exists to notice a revoke/expiry within roughly an hour rather than waiting for a portal
  // to happen to load the app again.
  "triggers": { "crons": ["13 * * * *"] }

  // Secrets (wrangler secret put): BITRIX_CLIENT_SECRET, APP_SECRET, TOKEN_ENC_KEY,
  // WASENDER_MASTER_TOKEN, ADMIN_SECRET (gates /admin/*), EDGE_SECRET (optional edge gate).
}
