{
  "name": "bitrix24-whatsapp-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Bitrix24 WhatsApp Connector - Bitrix24 Open Channel x WasenderAPI",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "test": "vitest run",
    "ui:build": "vite build --config ui/vite.config.ts",
    "ui:dev": "vite --config ui/vite.config.ts",
    "build": "npm run ui:build",
    "db:local": "wrangler d1 execute acpzap --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute acpzap --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^5.20260702.0",
    "@phosphor-icons/react": "^2.1.7",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  }
}
